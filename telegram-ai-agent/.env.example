# --- Your personal Telegram account (receives & sends the customer chats) ---
# Get both values at https://my.telegram.org → "API development tools"
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef

# --- Approval bot (the worker's control panel with the buttons) ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# Where drafts go for approval: your support worker's user ID, or a staff
# group's chat ID. Leave 0 at first, send /id to the approval bot to find it.
ADMIN_CHAT_ID=0

# --- Anthropic API key from https://platform.claude.com/ ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional tuning ---
CLAUDE_MODEL=claude-opus-4-8
STYLE_UPDATE_EVERY=10
DB_PATH=goldclub.db
SESSION_NAME=goldclub_user
