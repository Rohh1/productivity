# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...

# Anthropic API key from https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Where drafts go for approval: your support worker's user ID, or a staff
# group's chat ID. Leave 0 at first, message the bot with /id to find it.
ADMIN_CHAT_ID=0

# Optional tuning
CLAUDE_MODEL=claude-opus-4-8
STYLE_UPDATE_EVERY=10
DB_PATH=goldclub.db
