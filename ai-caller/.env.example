# ---- Anthropic (the AI that holds the conversation) ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-4-8.
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Twilio (the phone network) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# A Twilio number you own, in E.164 format.
TWILIO_FROM_NUMBER=+14155550100

# ---- Public URL ----
# The externally reachable base URL of THIS server. Twilio calls back to it,
# so it must be reachable from the internet. For local dev, run `ngrok http 3000`
# and paste the https URL here (no trailing slash).
PUBLIC_URL=https://your-tunnel.ngrok-free.app

# ---- Optional ----
PORT=3000
# The name the AI says it is calling on behalf of.
CALLER_NAME=Rohan
# Twilio TTS voice. See https://www.twilio.com/docs/voice/twiml/say/text-speech-translation
TWILIO_VOICE=Polly.Joanna
# Verify that inbound webhooks are really from Twilio. Keep "true" in production.
# Set to "false" only for local testing behind a proxy that rewrites the host.
VALIDATE_TWILIO_SIGNATURE=true
